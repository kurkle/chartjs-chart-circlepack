{
  "author": "Jukka Kurkela",
  "bugs": {
    "url": "https://github.com/kurkle/chartjs-chart-circlepack/issues"
  },
  "description": "Chart.js module for creating circle packing charts",
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/starlight": "^0.43.1",
    "@biomejs/biome": "^2.4.14",
    "@kurkle/astro-chartjs-editor": "^1.3.4",
    "@kurkle/configs": "^1.9.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-swc": "^0.4.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@swc/core": "^1.11.9",
    "@types/node": "^26.1.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-istanbul": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "astro": "^7.4.13",
    "chart.js": "^4.4.5",
    "chartjs-test-utils": "^1.1.1",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "rollup": "^4.21.2",
    "rollup-plugin-cleanup": "^3.2.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.esm.d.ts",
        "default": "./dist/chartjs-chart-circlepack.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/chartjs-chart-circlepack.cjs"
      },
      "script": "./dist/chartjs-chart-circlepack.min.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*",
    "!dist/docs/**"
  ],
  "homepage": "https://github.com/kurkle/chartjs-chart-circlepack#readme",
  "jsdelivr": "dist/chartjs-chart-circlepack.min.js",
  "keywords": [
    "chart.js",
    "chart",
    "circle packing",
    "circlepack",
    "bubble"
  ],
  "license": "MIT",
  "main": "dist/chartjs-chart-circlepack.cjs",
  "module": "dist/chartjs-chart-circlepack.esm.js",
  "name": "chartjs-chart-circlepack",
  "peerDependencies": {
    "chart.js": ">=4.0.0"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurkle/chartjs-chart-circlepack.git"
  },
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.json --emitDeclarationOnly && kurkle-build-cjs-types",
    "docs": "npm run build && astro build",
    "docs:dev": "npm run build && astro dev",
    "docs:version": "node ./docs/scripts/write-docs-version.cjs",
    "fixtures:update": "node scripts/update-fixtures.mjs",
    "format": "biome check --write",
    "icons": "kurkle-generate-icons",
    "lint": "biome check",
    "predocs": "npm run docs:version",
    "predocs:dev": "npm run docs:version",
    "prefixtures:update": "playwright install chromium",
    "prepack": "npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "pretest:fixture": "playwright install chromium firefox",
    "test": "npm run test:unit && npm run test:fixture && npm run test:pack",
    "test:fixture": "vitest run --config vitest.browser.config.ts --coverage",
    "test:pack": "kurkle-check-package",
    "test:unit": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc -p tsconfig.json --emitDeclarationOnly && tsc --noEmit -p tsconfig.tooling.json",
    "typecheck:docs": "astro check"
  },
  "sideEffects": [
    "dist/chartjs-chart-circlepack.cjs",
    "dist/chartjs-chart-circlepack.min.js"
  ],
  "type": "module",
  "types": "dist/index.esm.d.ts",
  "unpkg": "dist/chartjs-chart-circlepack.min.js",
  "version": "0.0.0-development"
}
