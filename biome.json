{
  "extends": ["./node_modules/@kurkle/configs/biome.json"],
  "files": {
    "includes": [
      "biome.json",
      "package.json",
      "rollup.config.js",
      "scripts/**/*.mjs",
      "src/**/*.ts",
      "test/helpers/**/*.ts",
      "test/setup.js",
      "test/specs/**/*.js",
      "tsconfig.test.json",
      "tsconfig.tooling.json",
      "vitest.browser.config.ts",
      "vitest.config.ts"
    ]
  },
  "overrides": [
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      },
      "includes": ["package.json"]
    }
  ]
}
